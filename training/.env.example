# Modèle d'environnement pour l'exécution LOCALE (cron sur ta machine).
#
#   cp training/.env.example training/.env
#   # renseigne les valeurs ci-dessous, puis :
#   ./training/run_weekly.sh --dry-run     # test sans envoyer
#
# ⚠️ training/.env contient des SECRETS (accès à tes comptes). Il est ignoré par
#    git (.gitignore) : ne le committe JAMAIS. Ce fichier .env.example, lui, ne
#    contient que des placeholders et reste versionné.
#
# `generate.py` charge automatiquement training/.env au démarrage : les commandes
# manuelles (strava-auth-url, garmin-connect-login, send…) marchent sans avoir à
# exporter ces variables dans le shell. Les vraies variables d'env du shell, si
# définies, restent prioritaires.

# --- Strava (lecture des activités) -----------------------------------------
# App : https://www.strava.com/settings/api
# Obtenir le refresh token (une fois) :
#   python3 training/generate.py strava-auth-url
#   python3 training/generate.py strava-auth-exchange --code <CODE>
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_REFRESH_TOKEN=

# --- Email (envoi hebdo via SMTP Gmail) -------------------------------------
# Mot de passe d'application (2FA requise) : https://myaccount.google.com/apppasswords
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=
MAIL_TO=                      # destinataire ; défaut = GMAIL_ADDRESS

# --- Garmin Connect (voie non-officielle, --push-connect) -------------------
# En LOCAL (IP résidentielle), le login e-mail+mot de passe fonctionne et le
# tokenstore ~/.garminconnect persiste : fais UNE fois
#   python3 training/generate.py garmin-connect-login   (franchit la MFA)
# ensuite les runs réutilisent/rafraîchissent les jetons tout seuls.
# GARMIN_TOKENS_BASE64 n'est PAS nécessaire en local (c'était pour le cloud éphémère).
GARMIN_EMAIL=
GARMIN_PASSWORD=
# GARMIN_TOKENSTORE=~/.garminconnect   # (option) dossier des jetons

# --- Calage du plan (optionnel) ---------------------------------------------
# PROGRAM_START=2026-08-31            # lundi de la semaine 1
# CROSS_TRAINING_WEIGHT=0.5           # poids du cross-training dans la charge aérobie
